# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
.astro/

# Generated/test PNG files in public root
public/*.png

# Original game data files (users supply their own — never commit these)
/data/*
!/data/.gitkeep

# Extracted/exported assets (generated by tools)
output/
public/extracted/
public/assets/
data/extracted/

# wwwdocs' synced doc pages (regenerated from root docs/ and packages/*/README.md
# by wwwdocs/scripts/sync-docs.mjs, run automatically before dev/build/preview --
# never hand-edit these directly, and never commit them: a committed copy
# would immediately go stale the same way the old hand-copied ones did)
wwwdocs/src/content/docs/start-here/
wwwdocs/src/content/docs/packages/
wwwdocs/src/content/docs/guides/
wwwdocs/src/content/docs/recompilation/
wwwdocs/src/content/docs/roadmap/
# ...and the homepage's package list, derived from the same READMEs.
wwwdocs/generated/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# npm auth tokens (never commit)
.npmrc
