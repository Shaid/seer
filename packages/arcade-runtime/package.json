{
  "name": "@seer-project/arcade-runtime",
  "version": "0.1.0",
  "description": "Runtime shell for browser-native arcade reimplementations: fixed-step loop, indexed-framebuffer presenter (WebGL2 palette shader + Canvas2D fallback), keyboard/gamepad input masks, DIP switches, save states, replays, state hashes and an AudioWorklet host",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git",
    "directory": "packages/arcade-runtime"
  },
  "keywords": [
    "reverse-engineering",
    "arcade",
    "game-loop",
    "webgl",
    "audioworklet",
    "replay"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worklet": {
      "types": "./dist/worklet/index.d.ts",
      "import": "./dist/worklet/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@seer-project/retro-display": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  },
  "homepage": "https://seer.shaid.net",
  "bugs": {
    "url": "https://github.com/Shaid/seer/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
