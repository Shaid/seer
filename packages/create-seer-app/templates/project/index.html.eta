<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= it.displayName %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; background: #000; }
    #game-container { width: 100%; height: 100%; }

    /*
     * Placeholder-splash styling — src/main.ts renders into #game-container
     * until it boots a real engine. Delete this block (and the matching
     * DOM it targets) once #game-container is driven by createGame().
     */
    #game-container.splash {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding: 2rem;
      overflow-y: auto;
      color: #e7eef0;
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      text-align: center;
    }
    #game-container.splash .eyebrow {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #4fd6ca;
    }
    #game-container.splash h1 {
      font-size: clamp(1.6rem, 5vw, 2.6rem);
      font-weight: 700;
    }
    #game-container.splash .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      justify-content: center;
      max-width: 40rem;
    }
    #game-container.splash .chip {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.75rem;
      padding: 0.2rem 0.6rem;
      border: 1px solid #2a3a40;
      border-radius: 999px;
      color: #a3b4b8;
    }
    #game-container.splash .chip.platform {
      color: #4fd6ca;
      border-color: #2a5450;
    }
    #game-container.splash a.viewer-link {
      margin-top: 0.75rem;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.9rem;
      color: #0d1417;
      background: #4fd6ca;
      padding: 0.6rem 1.2rem;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
    }
    #game-container.splash a.viewer-link:hover { opacity: 0.85; }
    #game-container.splash .note {
      max-width: 34rem;
      font-size: 0.8rem;
      color: #607276;
    }
  </style>
</head>
<body>
  <div id="game-container"></div>
  <script type="module" src="/src/main.ts"></script>
</body>
</html>
