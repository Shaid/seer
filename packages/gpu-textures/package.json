{
  "name": "@seer-project/gpu-textures",
  "version": "0.1.0",
  "description": "GPU texture codecs used by modern console decompilation: Tegra X1 (Nintendo Switch) block-linear (de)swizzling, BC1-7/S3TC block compression (including a full spec-conformant BC7 decoder), ASTC, and Zstandard decompression",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git",
    "directory": "packages/gpu-textures"
  },
  "keywords": [
    "switch",
    "tegra",
    "bc7",
    "s3tc",
    "dxt",
    "astc",
    "zstd",
    "texture",
    "reverse-engineering"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@tootallnate/astc-wasm": "^0.0.1",
    "@tootallnate/zstd-wasm": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  },
  "homepage": "https://seer.shaid.net",
  "bugs": {
    "url": "https://github.com/Shaid/seer/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
