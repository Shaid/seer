import type { AtlasFrame, AtlasMeta } from '@seer-project/core';

export type { AtlasFrame, AtlasMeta };

export interface PaletteData {
  colors: { r: number; g: number; b: number }[];
}

/**
 * One row of `manifest.json` — the canonical shape written by the build
 * pipeline (see tools/<game>/build-assets.ts) and read by the viewer. This
 * is the single source of truth for that shape; don't redeclare it locally
 * elsewhere (see docs/weaknesses.md §6 for what happens when it drifts).
 */
export interface ManifestEntry {
  name: string;
  /** Asset kind (e.g. "sprite", "screen", "map"). Drives the filter tabs — see docs/viewer.md. */
  type: string;
  sprites: number;
  hasPalette: boolean;
  /** Baked RGBA sprite sheet, drawn via the default Canvas2D path. */
  png: string;
  /**
   * Optional indexed-color variant of `png` (palette index in the R
   * channel, written by `writeIndexedPNG` from @seer-project/pipeline). When
   * present, the viewer's WebGL shader view becomes available for this
   * asset — see docs/viewer.md.
   */
  indexedPng?: string;
  /**
   * Optional manifest-sharding fields (see docs/viewer.md and
   * `@seer-project/pipeline`'s `writeShardedManifest`) — set on every entry
   * only when the project's pipeline opts into category navigation.
   * `category` picks which `manifest/<category>.json` shard the entry
   * lives in; `group` is a free finer-grained filter within that category,
   * used for `manifest/<category>/<group>.json` sub-shards once a category
   * grows past the sharding threshold.
   */
  category?: string;
  group?: string;
}

/** One entry of `public/assets/games.json`, fetched to populate the game/platform selectors. */
export interface GamesManifestEntry {
  id: string;
  displayName: string;
  platforms: { id: string; displayName: string }[];
}

/** One `group` row within a category that got group-level sub-sharding — see `@seer-project/pipeline`'s `GroupIndexEntry`. */
export interface GroupIndexEntry {
  /** Machine id — also the sub-shard filename stem: `manifest/<category>/<id>.json`. */
  id: string;
  count: number;
}

/**
 * One row of `public/assets/<game>/<platform>/categories.json` — the
 * lightweight top-level index a viewer fetches instead of the full
 * manifest on load. Presence of this file (non-empty) switches the viewer
 * into category-navigation mode; its absence (a project/platform that
 * hasn't adopted this convention) falls back to the original flat
 * single-`manifest.json`-fetch-on-load behavior unchanged.
 */
export interface CategoryIndexEntry {
  /** Machine id — also the shard filename stem: `manifest/<id>.json` (always present, regardless of `groups`). */
  id: string;
  /** Human label; the viewer falls back to `id` itself when absent. */
  displayName?: string;
  /** Total entries in this category (all types combined). */
  count: number;
  /** Present only when this category was also split by `group` (see `GROUP_SHARD_THRESHOLD` in `@seer-project/pipeline`'s manifest-sharding module) — `manifest/<category>/<group>.json` sub-shards, cheaper to fetch than the flat `manifest/<id>.json` for a huge category. */
  groups?: GroupIndexEntry[];
}

export function setHidden(el: HTMLElement, hidden: boolean) {
  el.classList.toggle('hidden', hidden);
}
