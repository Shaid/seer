{
  "name": "create-seer-viewer",
  "version": "0.1.0",
  "description": "Scaffold a standalone asset viewer for a seer project",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git"
  },
  "keywords": [
    "scaffold",
    "viewer",
    "reverse-engineering",
    "game"
  ],
  "type": "module",
  "main": "./dist/scaffold.js",
  "types": "./dist/scaffold.d.ts",
  "exports": {
    ".": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-seer-viewer": "./bin/create-seer-viewer.mjs"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/ bin/"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.2.0",
    "@types/node": "^26.0.1"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "eta": "^4.6.0"
  }
}
