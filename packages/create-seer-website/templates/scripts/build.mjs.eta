// Build helper for the <%= it.displayName %> docs site.
//
// Two jobs:
//   1. Copy the repo's extracted assets (public/assets/<%= it.game %>) into this
//      site's own public/ so the site is self-contained and images render.
//   2. Generate the Starlight sidebar (generated/sidebar.mjs) from the curated
//      page manifest (src/content/docs/<%= it.game %>/_sidebar.json).
//
// A third, optional step generates public/favicon.png from a sprite atlas
// frame once the project has pointed FAVICON_FRAME at a real one (see
// README.md) — until then a generic placeholder favicon ships as-is.
//
// Locally, extracted assets are copied from the repo's public/assets
// directory. In CI, the committed www/public build assets are reused instead
// — CI never has the original copyrighted game files. Run with:
//   node scripts/build.mjs

import { cpSync, existsSync, mkdirSync, readFileSync, writeFileSync, rmSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const GAME = '<%= it.game %>';
// See README.md "Pointing the favicon at a real sprite" — set these once the
// project has real extracted data, then re-run the build.
const FAVICON_FRAME = '<%= it.faviconFrame %>';
const FAVICON_ATLAS_DIR = '<%= it.faviconAtlasDir %>';
const FAVICON_MANIFEST = '<%= it.faviconManifest %>';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const repo = resolve(root, '..');

const ASSET_SRC = join(repo, 'public', 'assets', GAME);
const ASSET_DST = join(root, 'public', 'assets', GAME);
const MANIFEST = join(root, 'src', 'content', 'docs', GAME, '_sidebar.json');
const OUT_DIR = join(root, 'generated');
const OUT_SIDEBAR = join(OUT_DIR, 'sidebar.mjs');

// --- 1. Copy assets ---------------------------------------------------------

mkdirSync(join(root, 'public', 'assets'), { recursive: true });
if (existsSync(ASSET_SRC)) {
	rmSync(ASSET_DST, { recursive: true, force: true });
	cpSync(ASSET_SRC, ASSET_DST, { recursive: true });
	console.log(`Copied assets: ${ASSET_SRC} -> ${ASSET_DST}`);
} else if (existsSync(ASSET_DST)) {
	console.log(`Using committed site assets in ${ASSET_DST}`);
} else {
	throw new Error(`Missing extracted assets and committed site assets: ${ASSET_SRC}`);
}

// --- 2. Generate favicon (optional until FAVICON_FRAME is set) --------------

const faviconPath = join(root, 'public', 'favicon.png');
const faviconAtlasDir = join(ASSET_DST, FAVICON_ATLAS_DIR);
const faviconManifestPath = join(faviconAtlasDir, FAVICON_MANIFEST);
if (FAVICON_FRAME && existsSync(faviconManifestPath)) {
	const faviconResult = spawnSync(
		'node',
		[join(root, 'scripts', 'generate_favicon.mjs'), faviconAtlasDir, FAVICON_MANIFEST, FAVICON_FRAME, faviconPath],
		{ stdio: 'inherit' },
	);
	if (faviconResult.status !== 0) throw new Error('Could not generate the favicon');
} else if (existsSync(faviconPath)) {
	console.log(`Using existing favicon: ${faviconPath}`);
} else {
	console.warn(
		'No FAVICON_FRAME configured and no public/favicon.png present — see README.md "Pointing the favicon at a real sprite".',
	);
}

// --- 3. Generate sidebar -----------------------------------------------------

const manifest = JSON.parse(readFileSync(MANIFEST, 'utf8'));

const toSidebar = (entry) => {
	if (entry.items) {
		return {
			label: entry.label,
			items: entry.items.map(toSidebar),
		};
	}
	return { label: entry.label, slug: entry.slug };
};

const sidebar = manifest.map(toSidebar);

mkdirSync(OUT_DIR, { recursive: true });
writeFileSync(
	OUT_SIDEBAR,
	`// Generated by scripts/build.mjs — do not edit by hand.\n` +
		`// Source manifest: src/content/docs/${GAME}/_sidebar.json\n` +
		`export const sidebar = ${JSON.stringify(sidebar, null, 2)};\n`,
);
console.log(`[sidebar] wrote ${OUT_SIDEBAR} (${sidebar.length} top-level groups)`);
