{
  "name": "@seer-project/engine-2d",
  "version": "0.1.0",
  "description": "PixiJS-based 2D runtime engine with camera, input, and display management",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git"
  },
  "keywords": [
    "pixijs",
    "2d",
    "engine",
    "game",
    "camera"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pixi-helpers": {
      "types": "./dist/pixi-helpers.d.ts",
      "import": "./dist/pixi-helpers.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "peerDependencies": {
    "pixi.js": "^8.9.0"
  },
  "devDependencies": {
    "pixi.js": "^8.9.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  }
}
