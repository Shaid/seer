{
  "name": "@seer-project/cri",
  "version": "0.1.0",
  "description": "CRI Middleware format readers: CPK archive containers (with CRILAYLA decompression and the shared @UTF table engine), the ADX 4-bit ADPCM audio codec, and ACB/AWB sound-bank containers — optional, install only if your target ships CRI Middleware (CPK/ADX/ACB/AWB) data",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git",
    "directory": "packages/cri"
  },
  "keywords": [
    "cri",
    "cri-middleware",
    "cpk",
    "adx",
    "acb",
    "awb",
    "crilayla",
    "audio",
    "reverse-engineering"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@seer-project/core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  },
  "homepage": "https://seer.shaid.net",
  "bugs": {
    "url": "https://github.com/Shaid/seer/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
