{
  "name": "@seer-project/skeleton",
  "version": "0.1.0",
  "description": "Engine-agnostic skeleton retargeting for offline rig conversion: structural humanoid core-bone labelling, cross-skeleton bone correspondence (optimal per-fork assignment), skin-weight transfer and bind-pose reconciliation over plain TRS bone arrays",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git",
    "directory": "packages/skeleton"
  },
  "keywords": [
    "skeleton",
    "retarget",
    "rig",
    "skinning",
    "3d",
    "reverse-engineering"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@seer-project/gltf": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  },
  "homepage": "https://seer.shaid.net",
  "bugs": {
    "url": "https://github.com/Shaid/seer/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
