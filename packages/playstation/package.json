{
  "name": "@seer-project/playstation",
  "version": "0.1.0",
  "description": "PlayStation-family (PSX/PS2/PSP) hardware and disc-format primitives: raw CD sector/ISO9660/cue-sheet handling, the standard TIM texture format, STR MDEC video + CD-XA audio containers, LZS decompression, SPU reverb, and PSP ATRAC3+ extraction — optional, install only if your target is a PlayStation-family title",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shaid/seer.git",
    "directory": "packages/playstation"
  },
  "keywords": [
    "psx",
    "playstation",
    "psp",
    "tim",
    "cd-xa",
    "iso9660",
    "emulation",
    "reverse-engineering"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@seer-project/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.0"
  },
  "homepage": "https://seer.shaid.net",
  "bugs": {
    "url": "https://github.com/Shaid/seer/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
