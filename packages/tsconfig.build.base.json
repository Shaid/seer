{
  // Shared emit settings for every publishable package's `tsc -b` build.
  //
  // Each package's own tsconfig.build.json extends this *after* its
  // tsconfig.json, so these win over the repo-root no-emit type-check config,
  // and adds only its own `references`.
  //
  // `${configDir}` (TypeScript 5.5+) resolves against the *extending* config's
  // directory rather than this file's. Plain relative paths here would all
  // resolve to packages/ itself — outDir would become packages/dist — so every
  // path below must keep the prefix.
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    // Explicitly OFF, overriding the repo-root tsconfig each package inherits
    // (that one keeps it on for the app and tools/, where nothing is emitted).
    //
    // allowImportingTsExtensions + rewriteRelativeImportExtensions rewrite
    // `./x.ts` -> `./x.js` in emitted *JavaScript* but leave the specifiers
    // untouched in emitted *declarations*, so every published .d.ts pointed at
    // a `.ts` file that `files` never ships and consumers with a default
    // tsconfig could not resolve the types at all. That was invisible in this
    // repo because every in-house consumer sets allowImportingTsExtensions
    // itself. Package source therefore imports `./x.js` directly, which tsc
    // and every bundler resolve back to `./x.ts` during development.
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/src/__tests__"]
}
