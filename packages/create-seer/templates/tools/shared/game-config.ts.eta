import {
  defineGameConfig,
  flattenConfigs,
  resolveDataDir,
  findFileCI,
  resType,
  writeJson,
  getGameConfig as _getGameConfig,
  getSupportedPlatforms as _getSupportedPlatforms,
  type GameConfig as BaseGameConfig,
  type PlatformConfig as BasePlatformConfig,
} from '@seer-project/pipeline';
import {
  GAME_IDS,
  PLATFORM_IDS,
  DEFAULT_GAME,
  DEFAULT_PLATFORM,
  type GameId,
  type PlatformId,
} from '../../src/game-id.ts';

export { GAME_IDS, PLATFORM_IDS, DEFAULT_GAME, DEFAULT_PLATFORM, flattenConfigs, resolveDataDir, findFileCI, resType };
export type { GameId, PlatformId };

export interface PlatformConfig extends Omit<BasePlatformConfig, "platform"> {
  platform: PlatformId;
  /** Human-readable platform label for UI selectors (e.g. "DOS VGA"). Falls back to the platform id when omitted. */
  displayName?: string;
}

export interface GameConfig extends Omit<BaseGameConfig, "id" | "platforms"> {
  id: GameId;
  platforms: PlatformConfig[];
}

export const GAME_CONFIGS: GameConfig[] = defineGameConfig([{
  id: '<%= it.game %>',
  displayName: '<%= it.displayName %>',
  platforms: [{
    platform: '<%= it.platform %>',
    dataDirs: ['<%= it.game %>/<%= it.platform %>'],
    executable: undefined,
    expectedFiles: [],
    supported: false,
    assetDir: '<%= it.game %>',
    features: {},
  }],
}]);

export const GAME_PLATFORMS = flattenConfigs(GAME_CONFIGS);

export function getGameConfig(game: GameId, platform: PlatformId): PlatformConfig | undefined {
  return _getGameConfig(GAME_PLATFORMS, game, platform) as PlatformConfig | undefined;
}

export function getSupportedPlatforms(game: GameId): PlatformId[] {
  return _getSupportedPlatforms(GAME_PLATFORMS, game) as PlatformId[];
}

/**
 * Shape written to `public/assets/games.json` — the data-driven source for
 * the asset viewer's game/platform selectors (see docs/viewer.md). Derived
 * entirely from GAME_CONFIGS, so adding a game or platform here is all it
 * takes for the viewer to pick it up; no viewer template changes needed.
 */
export interface GamesManifestEntry {
  id: string;
  displayName: string;
  platforms: { id: string; displayName: string }[];
}

/** Write the games+platforms manifest the viewer's selectors fetch at startup. */
export function writeGamesManifest(outFile: string): void {
  const games: GamesManifestEntry[] = GAME_CONFIGS.map((g) => ({
    id: g.id,
    displayName: g.displayName,
    platforms: g.platforms.map((p) => ({
      id: p.platform,
      displayName: p.displayName ?? p.platform,
    })),
  }));
  writeJson(outFile, games);
}
