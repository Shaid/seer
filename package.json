{
  "name": "seer-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Boilerplate for browser-based, data-file-first game reverse-engineering projects",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/*/src/ packages/*/bin/ src/ tools/",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'src/**/*.ts' 'tools/**/*.ts'",
    "hex-dump": "tsx packages/pipeline/src/hex-dump.ts",
    "extract-data": "tsx tools/extract-game-data.ts",
    "build-assets": "tsx tools/extract-game-data.ts --assets-only",
    "create": "tsx packages/create-seer/bin/seer-create.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@seer/core": "*",
    "@seer/engine": "*",
    "@seer/pipeline": "*",
    "@seer/iff": "*",
    "pixi.js": "^8.9.0",
    "pngjs": "^7.0.0"
  }
}
