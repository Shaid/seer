{
  "name": "seer-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Boilerplate for browser-based, data-file-first game reverse-engineering projects",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite --host",
    "build": "npm run build:packages && tsc && vite build",
    "build:packages": "npm run build --workspaces",
    "preview": "vite preview --host",
    "test": "npm run build:packages && vitest run",
    "test:watch": "npm run build:packages && vitest",
    "lint": "eslint packages/*/src/ packages/*/bin/ src/ tools/",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'src/**/*.ts' 'tools/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'src/**/*.ts' 'tools/**/*.ts'",
    "hex-dump": "npm run build:packages && tsx packages/pipeline/src/hex-dump.ts",
    "extract-data": "npm run build:packages && tsx tools/extract-game-data.ts",
    "build-assets": "npm run build:packages && tsx tools/extract-game-data.ts --assets-only",
    "create": "npm run build:packages && node packages/create-seer-app/bin/create-seer-app.mjs",
    "dev:docs": "npm run dev --prefix wwwdocs",
    "build:docs": "npm run build --prefix wwwdocs",
    "preview:docs": "npm run preview --prefix wwwdocs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@seer-project/core": "^0.1.0",
    "@seer-project/engine-2d": "^0.1.0",
    "@seer-project/pipeline": "^0.1.0",
    "@seer-project/iff": "^0.1.0",
    "pixi.js": "^8.9.0",
    "pngjs": "^7.0.0"
  }
}
